modules = ["nodejs-20", "web", "nix"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV            = "development"
PORT                = "3000"
API_PREFIX          = "api/v1"

# ── Token lifetimes (non-secret) ─────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN  = "15m"
JWT_REFRESH_EXPIRES_IN = "30d"

# ── Database defaults (URI is a Secret) ──────────────────────────────────────
MONGODB_DB_NAME = "siraja"

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
TENANCY_STRATEGY    = "header"
DEFAULT_TENANT_SLUG = "platform"

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL   = "60"
THROTTLE_LIMIT = "100"

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS = "http://localhost:3000,http://localhost:5000"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL = "debug"

# ── Storage driver (credentials are Secrets) ─────────────────────────────────
STORAGE_DRIVER = "noop"
STORAGE_REGION = "auto"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8899
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flutter Frontend"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run start:dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Flutter Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && flutter pub get && flutter run -d web-server --web-port 5000 --web-hostname 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
